APP_ENV=development

# Postgres — used by the backend; also configures the postgres container
# in docker-compose.yml (POSTGRES_USER/PASSWORD/DB must match this URL).
DATABASE_URL=postgresql://campusai:campusai@postgres:5432/campusai

# Qdrant vector database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Redis cache
REDIS_URL=redis://redis:6379/0

# LLM_PROVIDER: "local" (Ollama, no key needed) or "openai" (requires LLM_API_KEY)
LLM_PROVIDER=local
LLM_API_KEY=

# EMBEDDING_PROVIDER: "local" (sentence-transformers) or "openai"
EMBEDDING_PROVIDER=local

# Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Auth
JWT_SECRET=

# Frontend — the URL the browser calls (not a container-to-container
# name); defaults to this same value if unset. Next.js inlines
# NEXT_PUBLIC_* vars at build time, so changing this for
# `docker compose up --build` means rebuilding the frontend image, not
# just changing this file.
NEXT_PUBLIC_API_URL=http://localhost:8000
